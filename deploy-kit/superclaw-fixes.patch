+        for node in re.findall(r"<node\b[^>]+>", xml or ""):
+            text_match = re.search(r'text="([^"]*)"', node)
+            if not text_match:
+                continue
+            node_text = html.unescape(text_match.group(1)).strip()
+            if node_text not in REWARD_FLOAT_MARKERS:
+                continue
+            bounds = self._node_bounds(node)
+            if not bounds:
+                continue
+            left, top, right, bottom = bounds
+            # 只认上半屏靠右的悬浮球，避免误判底部操作按钮
+            if right >= self.width * 0.5 and bottom <= self.height * 0.5:
+                return ((left + right) // 2, (top + bottom) // 2)
+        return None
