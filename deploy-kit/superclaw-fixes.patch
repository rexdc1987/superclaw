+    def _dismiss_reward_float(self) -> bool:
+        """消除播放页右上角的金币红包悬浮球（"16888 立即领取"）。
+
+        该悬浮球会在播放页上叠一层透明 Compose 触摸层，导致评论按钮点击
+        完全无效。2026-09-11 任务340 第22集失败即由此引起。
+        关闭顺序按破坏性从小到大：显式关闭控件 -> 点开悬浮球后返回。
+        """
+        if not self._reward_float_visible():
+            return False
+
+        for selector in (
+            {"description": "关闭"},
+            {"descriptionContains": "关闭"},
+            {"text": "关闭"},
+        ):
+            try:
+                button = self.d(**selector)
+                if not self._exists(button, 0.4):
+                    continue
+                button.click()
+                time.sleep(0.8)
