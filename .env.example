# Web security
SUPERCLAW_AUTH_REQUIRED=true
SUPERCLAW_AUTH_SECRET=replace-with-at-least-32-random-characters
SUPERCLAW_AUTH_TOKEN_TTL=43200
SUPERCLAW_CORS_ORIGINS=https://superclaw.example.com

# Runtime
SUPERCLAW_API_PORT=8980
SUPERCLAW_EXECUTION_MODE=embedded
SUPERCLAW_SCREENSHOT_ROOT=D:/SuperClawData/screenshots/hongguo
SUPERCLAW_MUMU_ROOT=D:/Program Files/Netease/MuMu
SUPERCLAW_DB_PASSWORD=replace-me
SUPERCLAW_DB_HOST=mysql
SUPERCLAW_DB_PORT=3306
SUPERCLAW_DB_NAME=superclaw
SUPERCLAW_DB_USER=superclaw

# AI provider
XIAOMI_API_KEY=replace-me
OPENAI_API_KEY=replace-me
